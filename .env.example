# Copiá este archivo como .env.local (no se sube al repo) o cargá las variables en Cloudflare Pages.
# Las dos son opcionales.

# Google Analytics 4 (G-XXXXXXXXXX). Vacío = sin medición, sin cookies y sin pedidos a Google.
# No usar el ID de la web vieja (G-9VW891H1TV) sin confirmar de quién es.
NEXT_PUBLIC_GA_ID=

# Correo que se muestra en la web. Vacío = contacto@roleran.com.uy (a confirmar).
NEXT_PUBLIC_EMAIL_CONTACTO=

# Dirección pública del sitio (canónicas, sitemap, Open Graph, JSON-LD, robots). Vacío = https://www.roleran.com.uy
NEXT_PUBLIC_SITIO_URL=

# false = agrega «X-Robots-Tag: noindex, nofollow» a todo (copias de prueba o dominios temporales). Vacío = se indexa.
SITIO_INDEXAR=
